# LaserEditor container environment — copy to .env next to compose.yaml.
# install.sh generates this automatically (with a random admin token).

# Admin bearer token (admin UI / queue API / agents). install.sh generates
# a random one; when migrating ML30 data, keep agents in sync with this value.
LASER_ADMIN_TOKEN=change-me

# uvicorn worker count: 4 = default (Pi 4B 4GB / ML30 parity), 2 = 2GB VPS
LASER_WORKERS=4

# Which image compose pulls (B3-a release contract).
#
#   LASER_IMAGE_TAG    — the readable name. A formal version (v1.0.0), or
#                        `latest` = whatever main built most recently.
#   LASER_IMAGE_DIGEST — the immutable identity. When set it decides the bytes;
#                        the tag above becomes a label a human can read.
#
# A formal install pins both, and rollback means naming an earlier pair. The tag
# alone is not a release reference: `latest` moves on every push to main, and
# even a version tag is only a pointer. Set the digest and the artifact cannot
# change under you. `scripts/release.py verify` prints both for any version.
LASER_IMAGE_TAG=latest
#LASER_IMAGE_DIGEST=sha256:...

# Extra CORS origins, comma-separated (only needed for a split frontend;
# the bundled same-origin frontend works without it)
#LASER_CORS_ORIGINS=

# Same-Host Mode: the folder ScanSnap Home saves into, as an absolute path on
# THIS machine. Spaces are fine and need no quoting — compose reads the file
# literally. Leave it unset and the folder watcher stays idle.
# The container always sees that folder as /scan-inbox; only the host side varies.
#LASER_EXTERNAL_INBOX_HOST=/Users/you/Documents/ScanSnap Home folder

# 松 profile only: Cloudflare Tunnel token (dashboard-managed tunnel)
#CLOUDFLARED_TOKEN=
